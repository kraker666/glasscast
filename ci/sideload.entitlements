<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ad-hoc signed into the IPA by CI so SideStore can see which entitlements the app wants.
     SideStore re-signs with the free Apple ID's own identifiers and keychain group, and drops
     anything a free team is not allowed. Same Wi-Fi entitlements as Meta's CameraAccess sample. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
